{
  "name": "devrelay",
  "version": "0.4.3",
  "private": true,
  "description": "A minimal MCP bridge for arbitrary command-line execution on a development machine.",
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "bin": {
    "devrelay": "dist/src/main.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-force-exit dist/test/*.test.js gui/setup/*.test.mjs",
    "start": "node dist/src/main.js",
    "start:http": "node dist/src/main.js --http",
    "gui": "node gui/devrelay-gui.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "postinstall": "node -e \"if(process.platform==='darwin'){const fs=require('node:fs');for(const a of ['arm64','x64']){const f='node_modules/node-pty/prebuilds/darwin-'+a+'/spawn-helper';if(fs.existsSync(f))fs.chmodSync(f,0o755)}}\""
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "electron": "^44.5.1",
    "iconv-lite": "^0.7.0",
    "node-pty": "^1.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  }
}
