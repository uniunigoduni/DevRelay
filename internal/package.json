{
  "name": "devrelay",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal MCP bridge for arbitrary command-line execution on a development machine.",
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "bin": {
    "devrelay": "dist/src/main.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-force-exit dist/test/*.test.js",
    "start": "node dist/src/main.js",
    "start:http": "node dist/src/main.js --http",
    "gui": "node gui/devrelay-gui.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "iconv-lite": "^0.7.0",
    "node-pty": "^1.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  }
}
